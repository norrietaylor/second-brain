filters: type == "github"
views:
  - type: table
    name: All
    order:
      - file.name
      - github_state
      - github_repo
      - github_number
      - github_url
      - github_last_synced
    sort:
      - property: github_last_synced
        direction: DESC
  - type: table
    name: Open
    filters: github_state == "open"
    order:
      - file.name
      - github_repo
      - github_number
      - github_url
      - github_last_synced
    sort:
      - property: github_last_synced
        direction: DESC
